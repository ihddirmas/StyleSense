# Points to FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production: https://style-sense-beryl.vercel.app (master on Vercel)
# Production API: https://styleai-backend-5vk9.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public anon key - safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hardcoded demo user
NEXT_PUBLIC_DEMO_USER_ID=demo-user-001

# Error monitoring via @sentry/nextjs (optional, leave unset to disable entirely).
# DSN can point at Sentry.io OR a self-hosted/hosted GlitchTip project -- GlitchTip
# implements the same ingestion protocol, so no code changes are needed either way.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Build-time only, for source map upload (leave unset to skip upload)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (product analytics - optional, leave unset to disable entirely).
# Either name works -- lib/posthog-key.ts falls back across both.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
