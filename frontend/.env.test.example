# Playwright E2E credentials — copy to .env.test.local (gitignored) and fill in.
# Use a seed QA account with real wardrobe items, not a fresh/empty one — several
# specs (cold-start, design-system) assert on populated-state UI.
#
# Either naming works locally and in CI (GitHub Actions secrets):
#   E2E_TEST_EMAIL / E2E_TEST_PASSWORD  (preferred for Playwright)
#   TEST_USER_EMAIL / TEST_USER_PASSWORD  (alias — same account as AGENTS.md)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
