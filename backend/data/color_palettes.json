  "undertone_characteristics": {
    "warm": {
      "vein_color": "green",
      "jewelry": "gold",
      "whites": ["ivory", "cream"],
      "avoid": ["icy pastels", "stark white", "silver undertones"]
    },
    "cool": {
      "vein_color": "blue/purple",
      "jewelry": "silver",
      "whites": ["pure white", "bright white"],
      "avoid": ["muddy oranges", "warm yellows", "brass tones"]
    },
    "neutral": {
      "vein_color": "blue-green",
      "jewelry": "both gold and silver",
      "whites": ["soft white", "off-white"],
      "avoid": ["extreme neons", "very harsh contrasts"]
    }
  },
  "contrast_levels": {
    "low": {
      "description": "Gentle, tonal color differences between hair/skin/eyes",
      "best_combinations": "monochrome, tonal, soft transitions",
      "avoid": "stark black/white, very bold contrasts"
    },
    "medium": {
      "description": "Moderate differences between hair/skin/eyes",
      "best_combinations": "most color combinations work well",
      "avoid": "extremes in either direction"
    },
    "high": {
      "description": "Strong differences between hair/skin/eyes (dark hair + light skin, or vice versa)",
      "best_combinations": "bold contrasts, jewel tones, black/white",
      "avoid": "muddy mid-tones, overly soft pastels"
    }
  }
}
