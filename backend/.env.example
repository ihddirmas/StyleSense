# Runway
RUNWAYML_API_SECRET=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Auth, Storage, social, and core DB via DATABASE_URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Core relational tables: users, wardrobe_items, try_on_results, outfits, stylist_sessions
# Dashboard → Project Settings → Database → Connection string (URI, pooler port 6543 on Render)
DATABASE_URL=

# One-time legacy split-DB cutover (scripts/migrate_legacy_db_to_supabase.py)
# LEGACY_DATABASE_URL=

# Anthropic (fallback chat stylist)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App config
FRONTEND_URL=http://localhost:3000
DEMO_USER_ID=demo-user-001

# Canonical QA login (agents, Playwright, manual E2E). See scripts/ensure_test_user.py
TEST_USER_EMAIL=qa@stylesense.test
TEST_USER_PASSWORD=
# Optional: comma-separated real emails cleanup must never delete
# TEST_USER_PROTECTED_EMAILS=admin@stylesense.com

# Sentry (error monitoring - optional, leave unset to disable entirely)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# PostHog (product analytics - optional, leave unset to disable entirely)
POSTHOG_API_KEY=
POSTHOG_HOST=[REDACTED]

# Resend (transactional email - optional, leave unset to disable entirely)
# Cap-hit nudge emails only for now -- no billing/receipts flow exists yet.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StyleSense <[REDACTED]>

# Redis (optional, leave unset to disable entirely). Only needed once WEB_CONCURRENCY
# > 1 in render.yaml -- shares rate_limit.py's cooldown state across worker processes.
# Below unset, each process falls back to its own in-memory dict (fine at 1 worker).
REDIS_URL=

# Backblaze B2 + Genblaze (Generative AI Media Hackathon — optional)
# When set, try-ons are ingested to B2 with provenance; animate uses Genblaze Pipeline + Runway.
# B2_BUCKET=
# B2_REGION=
# B2_KEY_ID=
# B2_APP_KEY=
# B2_PUBLIC_URL_BASE=  # optional CDN or B2 public URL prefix
# GENBLAZE_MEDIA=1
# GENBLAZE_ANIMATE=1
# GENBLAZE_INGEST=1
