{
  "expo": {
    "name": "StyleSense",
    "slug": "stylesense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stylesense",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.stylesense.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "StyleSense needs photo access to add wardrobe items and selfies for AI try-on.",
        "NSCameraUsageDescription": "StyleSense needs camera access to capture selfies and garments."
      }
    },
    "android": {
      "package": "ai.stylesense.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1714",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1714"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StyleSense to access your photos for wardrobe and try-on."
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "revenueCatProjectId": "proje81036ed",
      "revenueCatDashboard": "https://app.revenuecat.com/projects/e81036ed"
    }
  }
}
